# Copy to .env and fill in. Never commit .env.

# Public hostname (used by nginx + certbot)
DOMAIN=jobcard.example.com

# PostgreSQL
POSTGRES_USER=jobcard
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=jobcard
DATABASE_URL=postgres://jobcard:change-me-long-random@db:5432/jobcard

# Object storage (MinIO / any S3-compatible)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=jobcard-app
S3_SECRET_KEY=change-me-long-random
S3_BUCKET=vehicle-jobcards

# Session signing secret: openssl rand -base64 48
SESSION_SECRET=

# Account setup — only needed when running scripts/setup-users.mjs; remove afterwards.
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator
ADMIN_PASSWORD=
STAFF_USERNAME=staff
STAFF_NAME=Staff
STAFF_PASSWORD=
